{
  "name": "@openmouse/keyboard-protocol",
  "version": "0.1.0",
  "description": "Analog gaming keyboard protocol codecs and HID drivers used by OpenMouse.",
  "type": "module",
  "files": [
    "dist",
    "docs/wooting-support.md",
    "docs/razer-support.md",
    "docs/logitech-support.md",
    "docs/steelseries-support.md",
    "docs/keychron-support.md",
    "docs/arbiter-support.md",
    "README.md",
    "CONTRIBUTING.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./wooting": {
      "types": "./dist/wooting/index.d.ts",
      "import": "./dist/wooting/index.js"
    },
    "./wuque": {
      "types": "./dist/wuque/index.d.ts",
      "import": "./dist/wuque/index.js"
    },
    "./drivers": {
      "types": "./dist/drivers/index.d.ts",
      "import": "./dist/drivers/index.js"
    },
    "./drivers/*": {
      "types": "./dist/drivers/*.d.ts",
      "import": "./dist/drivers/*.js"
    },
    "./kochi": {
      "types": "./dist/kochi/index.d.ts",
      "import": "./dist/kochi/index.js"
    },
    "./razer": {
      "types": "./dist/razer/index.d.ts",
      "import": "./dist/razer/index.js"
    },
    "./logitech": {
      "types": "./dist/logitech/index.d.ts",
      "import": "./dist/logitech/index.js"
    },
    "./steelseries": {
      "types": "./dist/steelseries/index.d.ts",
      "import": "./dist/steelseries/index.js"
    },
    "./keychron": {
      "types": "./dist/keychron/index.d.ts",
      "import": "./dist/keychron/index.js"
    },
    "./arbiter": {
      "types": "./dist/arbiter/index.d.ts",
      "import": "./dist/arbiter/index.js"
    }
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "test": "tsx --import ./scripts/fast-test-timers.mjs --test \"src/**/*.test.ts\"",
    "check": "npm run build && npm test && npm pack --dry-run",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "tsx": "^4.23.11",
    "typescript": "^5.8.3",
    "semantic-release": "25.0.9"
  },
  "engines": {
    "node": ">=20"
  },
  "sideEffects": [],
  "license": "AGPL-3.0-or-later",
  "publishConfig": {
    "access": "public"
  },
  "release": {
    "branches": [
      "main"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenMouse-Project/keyboard-protocol.git"
  }
}
